// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_V3")
}


model Session {
  id           Int          @id @default(autoincrement())
  title        String
  notes        String
  instruments  Tag[] @relation("SessionInstruments")
  duration     Int
  isPublic     Boolean
  createdAt    DateTime     @default(now())
  musicianId   Int
  musician     Musician     @relation(fields: [musicianId], references: [id])
  gasUps       GasUp[]
  comments     Comment[]
  media        Media[]
  tags         Tag[] @relation("SessionTags")
  tasksInUse           TaskInUse[]
}

model TaskDefinition {
  id           Int          @id @default(autoincrement())
  title        String
  musicianId   Int
  musician     Musician     @relation(fields: [musicianId], references: [id])
  createdAt    DateTime     @default(now())
  description        String
  checklist        String[]
  savedCount    Int
  usedCount      Int
  parentTaskId     Int?
  parentTask       TaskDefinition? @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subTasks         TaskDefinition[] @relation("TaskHierarchy")
  tasksInUse       TaskInUse[]
  tags         Tag[] @relation("TaskDefinitionTags")
}

model TaskInUse {
  id                   Int              @id @default(autoincrement())
  createdAt            DateTime         @default(now())
  duration             Int
  notes                String
  isSessionTask        Boolean
  checklistCompletions String[]

  // these task def properties are optional to allow for SessionTask functionality (these wont have a task def, they simply exist to track non-task practice time in a way that is easy to aggregate alongside task time)
  taskDefinitionId     Int?
  taskDefinition       TaskDefinition?   @relation(fields: [taskDefinitionId], references: [id])

  musicianId           Int
  musician             Musician         @relation(fields: [musicianId], references: [id])

  sessionId            Int
  session              Session          @relation(fields: [sessionId], references: [id])

  tags                 Tag[] @relation("TaskTags")

  @@index([taskDefinitionId])
  @@index([musicianId])
  @@index([sessionId])
}


model Musician  {
  id                  Int         @id @default(autoincrement())
  googleId            String?
  displayName            String      @unique
  givenName           String
  familyName          String
  email               String      @unique
  bio                 String?     @db.VarChar(300)
  instruments         Tag[]@relation("MusicianTags")

  avatarUrl   String?
  totalSessions       Int         @default(0)
  totalPracticeSeconds Int         @default(0)
  totalGasUpsGiven         Int         @default(0)
  totalGasUpsReceived         Int         @default(0)
  createdAt           DateTime    @default(now())
  gasUps              GasUp[]
  comments            Comment[]
  sessions            Session[]
  media               Media[]
  taskDefinitions     TaskDefinition[]
  tasksInUse          TaskInUse[]
  goals               Goal[] // Added: relation to Goal

  // Follow relationships
  followers           Follow[]    @relation("Following")
  following           Follow[]    @relation("Follower")

  @@index([id, email])
}

model Media {
  id         Int      @id @default(autoincrement())
  musicianId Int
  url        String
  type       String
  musician   Musician  @relation(fields: [musicianId], references: [id])
  session    Session?  @relation(fields: [sessionId], references: [id])
  sessionId  Int?
}

model GasUp {
  id         Int      @id @default(autoincrement())
  musicianId Int
  sessionId  Int
  musician   Musician @relation(fields: [musicianId], references: [id])
  session    Session  @relation(fields: [sessionId], references: [id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime  @default(now())
  musicianId Int
  sessionId  Int
  musician  Musician @relation(fields: [musicianId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Tag {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  color     String?  // optional, for UI
  createdAt DateTime @default(now())

  sessions  Session[] @relation("SessionTags")
  tasks     TaskInUse[] @relation("TaskTags")
  musicians Musician[] @relation("MusicianTags")
  sessionInstruments Session[] @relation("SessionInstruments")
  taskDefinitions TaskDefinition[] @relation("TaskDefinitionTags")
}

// Add enums for goal type and time frame

enum GoalType {
  duration
  frequency
}

enum GoalTimeFrame {
  daily
  weekly
  monthly
  annually
}

model Goal {
  id         Int           @id @default(autoincrement())
  musicianId Int
  musician   Musician      @relation(fields: [musicianId], references: [id])
  tag        String
  type       GoalType
  target     Int
  timeFrame  GoalTimeFrame
  createdAt  DateTime      @default(now())

  @@index([musicianId])
}

model Follow {
  id           Int       @id @default(autoincrement())
  followerId   Int
  followingId  Int
  createdAt    DateTime  @default(now())

  follower     Musician  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following    Musician  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}
